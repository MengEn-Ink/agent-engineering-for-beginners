{
  "name": "agent-engineering-for-beginners",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "pnpm validate && pnpm typecheck:projects && vitepress build docs && node scripts/check-dist.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "projects:check": "node scripts/check-projects.mjs",
    "sources:check": "node scripts/check-sources.mjs",
    "test": "vitest run",
    "typecheck:projects": "vue-tsc --noEmit -p tsconfig.projects.json",
    "validate": "node scripts/validate-content.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "parse-srcset": "1.0.2",
    "parse5": "8.0.1",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "saxes": "6.0.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.8.1"
  },
  "packageManager": "pnpm@9.15.9"
}
